PACKAGE_NAME=hailo1x_pci
PACKAGE_VERSION=@PCIE_DRIVER_VERSION@
BUILD_DIRECTORY=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build
MAKE="make -C ${kernel_source_dir} M=${BUILD_DIRECTORY} HAILO_DRIVER=pcie modules"
CLEAN="make -C ${kernel_source_dir} M=${BUILD_DIRECTORY} clean"
BUILT_MODULE_NAME=hailo1x_pci
BUILT_MODULE_LOCATION=.
DEST_MODULE_LOCATION=/updates/dkms
AUTOINSTALL=yes
